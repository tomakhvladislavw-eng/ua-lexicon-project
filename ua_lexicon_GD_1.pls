<?xml version="1.0" encoding="UTF-8"?>
<lexicon version="1.0"
         xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
         alphabet="ipa"
         xml:lang="uk-UA">

  <!-- пристрій (іменник): при́строю -->
  <lexeme>
    <grapheme>пристрою</grapheme>
    <phoneme>ˈprɪstrojʊ</phoneme>
  </lexeme>

  <!-- спо́соби -->
  <lexeme>
    <grapheme>способи</grapheme>
    <phoneme>ˈspɔsɔbɪ</phoneme>
  </lexeme>

  <!-- стрі́лка -->
  <lexeme>
    <grapheme>стрілка</grapheme>
    <phoneme>ˈstrʲilka</phoneme>
  </lexeme>

  <!-- нати́снути -->
  <lexeme>
    <grapheme>натиснути</grapheme>
    <phoneme>naˈtɪsnutɪ</phoneme>
  </lexeme>

  <!-- шабло́нів -->
  <lexeme>
    <grapheme>шаблонів</grapheme>
    <phoneme>ʃabˈlon.nʲiv</phoneme>
  </lexeme>

  <!-- впорядко́вані -->
  <lexeme>
    <grapheme>впорядковані</grapheme>
    <phoneme>vpɔrʲadˈkɔvan.nʲi</phoneme>
  </lexeme>

  <!-- загу́бляться -->
  <lexeme>
    <grapheme>загубляться</grapheme>
    <phoneme>zaˈɡublʲatʲsʲa</phoneme>
  </lexeme>

  <!-- ко́ротко -->
  <lexeme>
    <grapheme>коротко</grapheme>
    <phoneme>ˈkɔrɔtko</phoneme>
  </lexeme>

  <!-- вікнˈа -- в ед. ч.>
  <lexeme>
    <grapheme>вікна</grapheme>
    <phoneme>vʲikˈna</phoneme>
  </lexeme>


</lexicon>







































